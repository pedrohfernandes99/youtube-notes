{
    "manifest_version": 3,
    "name": "YouTube Focus",
    "version": "1.0.0",
    "description": "Extensão para focar nos estudos no YouTube.",
    "permissions": ["storage"],
    "host_permissions": ["https://www.youtube.com/*"],
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_title": "YouTube Focus"
    }
  }